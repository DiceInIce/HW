SELECT w."Id", w."CaloriesBurned", w."ClientId", w."Date", w."DurationMinutes", w."SessionType", w."TrainerId", t."Id", t."BirthDate", t."Email", t."FullName", t."MembershipType", t."RegistrationDate", t0."Id", t0."ExperienceYears", t0."FullName", t0."PhoneNumber", t0."Specialization", t1."Id", t1."ExerciseId", t1."Repetitions", t1."Sets", t1."Weight", t1."WorkoutSessionId", t1."Id0", t1."DifficultyLevel", t1."EquipmentRequired", t1."Name", t1."TargetMuscleGroup"
FROM fitness."WorkoutSessions" AS w
LEFT JOIN (
    SELECT c."Id", c."BirthDate", c."Email", c."FullName", c."MembershipType", c."RegistrationDate"
    FROM fitness."Clients" AS c
    WHERE c."MembershipType" <> 'Неактивный'
) AS t ON w."ClientId" = t."Id"
LEFT JOIN fitness."Trainers" AS t0 ON w."TrainerId" = t0."Id"
LEFT JOIN (
    SELECT w0."Id", w0."ExerciseId", w0."Repetitions", w0."Sets", w0."Weight", w0."WorkoutSessionId", e."Id" AS "Id0", e."DifficultyLevel", e."EquipmentRequired", e."Name", e."TargetMuscleGroup"
    FROM fitness."WorkoutExercises" AS w0
    INNER JOIN fitness."Exercises" AS e ON w0."ExerciseId" = e."Id"
) AS t1 ON w."Id" = t1."WorkoutSessionId"
ORDER BY w."Id", t."Id", t0."Id", t1."Id"
