        CREATE OR REPLACE FUNCTION fitness.CalculateClientAge(client_id INTEGER)
        RETURNS INTEGER AS $$
        BEGIN
            RETURN EXTRACT(YEAR FROM AGE((SELECT "BirthDate" FROM fitness."Clients" WHERE "Id" = client_id)))::INTEGER;
        END;
        $$ LANGUAGE plpgsql;
